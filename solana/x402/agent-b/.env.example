# Agent B — resource server (seller). Copy to .env.
# Holds no private key: it only names an address to be paid into.

PORT=8402
NETWORK=solana-devnet
FACILITATOR_URL=https://facilitator.payai.network

# Where payments land. This is a receive-only address — no key needed here.
TREASURY_ADDRESS=ABDpbo9dwKuKZVpQwcfcGCCzgLh6QYmDcnPDS6Qao6Bx

# 0.1 USDC at 6 decimals.
PRICE_ATOMIC=100000

# Used to build the resource URL in payment requirements. Must match the URL
# the client actually requests, or verification will not line up.
PUBLIC_BASE_URL=http://127.0.0.1:8402
