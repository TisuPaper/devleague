# Agent A — paying agent (buyer). Copy to .env.
#
# This is the only process in the repo that holds a spending key. Keep .env and
# the keypair file out of git (both are already gitignored) and never point
# AGENT_A_KEYPAIR at a key that also exists on mainnet.

PORT=8401
NETWORK=solana-devnet
AGENT_B_URL=http://127.0.0.1:8402

# Path to the throwaway devnet keypair, relative to where you start the process.
AGENT_A_KEYPAIR=../../.keys/agent-a.json

# Refuse to pay anyone but this address. Enforced in the beforePayment hook,
# before the transaction is built or signed.
EXPECTED_PAY_TO=ABDpbo9dwKuKZVpQwcfcGCCzgLh6QYmDcnPDS6Qao6Bx

# Hard per-payment ceiling in atomic USDC units (0.2 USDC). The quoted price is
# 0.1 USDC; this leaves headroom without allowing an unbounded quote.
MAX_PAYMENT_ATOMIC=200000

# Set to 1 for verbose x402 handshake logging.
VERBOSE=0
