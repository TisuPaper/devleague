# Caddy config for the deployed demo.
#
# SITE_ADDRESS is substituted from the environment (see docker-compose.yml).
#
#   PULL mode on a bare IP (default):
#     SITE_ADDRESS="http://:80, https://:443"
#   Serves plain HTTP, plus HTTPS with Caddy's internally-signed certificate.
#   The internal cert triggers a browser warning you click through, but it
#   means modern browsers -- which silently upgrade typed addresses to HTTPS --
#   get a response instead of ERR_CONNECTION_REFUSED. Pub/Sub is not involved
#   here (the backend pulls), so a publicly-trusted cert isn't needed.
#
#   PUSH mode (needs a real hostname):
#     SITE_ADDRESS=your.host.name
#   Caddy then provisions a real Let's Encrypt certificate, which Pub/Sub push
#   requires -- it rejects plain HTTP and self-signed certs.
{$SITE_ADDRESS} {
	encode zstd gzip

	# Serve HTTPS with a locally-signed cert when the site address has no
	# public hostname to get a real certificate for. Ignored (a real ACME cert
	# is used instead) when SITE_ADDRESS is a resolvable public hostname.
	tls internal

	# Backend API. Everything under /api goes to the FastAPI container.
	handle /api/* {
		reverse_proxy backend:8000 {
			# The pipeline does real work (Gmail fetch + Gemini call) before
			# responding; give it room rather than cutting the request off.
			transport http {
				response_header_timeout 120s
			}
		}
	}

	# Static dashboard, with SPA fallback to index.html
	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}

	# Hardening headers. Strict-Transport-Security is deliberately NOT set:
	# this deployment is reachable over plain HTTP, and advertising HSTS on a
	# connection that isn't guaranteed to be TLS is misleading at best. Add it
	# back only when serving exclusively over HTTPS with a trusted cert.
	header {
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "no-referrer"
		Content-Security-Policy "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
		-Server
	}

	log {
		output stdout
		format console
	}
}
