APP_NAME=Financial Email Receiver
ENVIRONMENT=development
GOOGLE_CLOUD_PROJECT_ID=gentle-exchange-476817-u6
GMAIL_PUBSUB_TOPIC=gmail-financial-reports
DOWNLOAD_DIR=downloads

# Optional: shared secret for the Pub/Sub push webhook. If set, configure the
# Pub/Sub push subscription endpoint as .../api/webhooks/gmail?token=<value>.
# Leave blank for local hackathon testing only. See README "Security Notes".
PUBSUB_VERIFICATION_TOKEN=

# Gemini API key for the financial-analysis step. Leave blank to skip AI
# analysis entirely (extraction + redaction still run either way).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# Comma-separated sender-domain allowlist, e.g. "n2nconnect.com,client2.com".
# Leave blank to process attachments from every sender in the watched inbox.
ALLOWED_SENDER_DOMAINS=n2nconnect.com
